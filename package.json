{
  "name": "trueglass",
  "version": "1.0.3",
  "private": false,
  "license": "MIT",
  "description": "True liquid glass for the web: zero-dependency optical refraction engine and UI component suite with Snell bezel bending, chromatic dispersion, droplet fusion, and adaptive contrast.",
  "type": "module",
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./core": {
      "types": "./dist-lib/core/index.d.ts",
      "import": "./dist-lib/core/index.js"
    },
    "./components": {
      "types": "./dist-lib/components/index.d.ts",
      "import": "./dist-lib/components/index.js"
    },
    "./styles.css": "./dist-lib/styles.css",
    "./trueglass.css": "./dist-lib/styles.css"
  },
  "files": [
    "dist-lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kicode01/trueglass.git"
  },
  "homepage": "https://trueglass.vercel.app",
  "bugs": {
    "url": "https://github.com/kicode01/trueglass/issues"
  },
  "keywords": [
    "trueglass",
    "liquid-glass",
    "fluid-glass",
    "glassmorphism",
    "backdrop-filter",
    "refraction",
    "snell-law",
    "chromatic-dispersion",
    "webgl2",
    "svg-filter",
    "squircle",
    "ui-components",
    "zero-dependency",
    "typescript"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm test && npm run build:lib",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^2.1.8"
  }
}
